              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/cancel": {
      "post": {
        "summary": "Cancel",
        "description": "Ask the running job to stop. Nothing running is not an error: Stop twice is still stopped.",
        "operationId": "cancel_api_cancel_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppState"
                }
              }
            }
          }
        }
      }
    },
    "/api/labels": {
      "get": {
        "summary": "Get Labels",
        "description": "Spec 7.4: the labels written SO FAR, so a half-finished labelling run is visible live.\n\nThe Claude batches on disk in sorted filename order, then Jev's answer wherever Claude has none or\nJev is confident - the first two steps of the apply merge (spec 7.3), so what the page animates is\nwhat the sort will actually do. A damaged file is skipped rather than allowed to blank the live view.",
        "operationId": "get_labels_api_labels_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Get Labels Api Labels Get"
                }
              }
            }
          }
        }
      }
    },
