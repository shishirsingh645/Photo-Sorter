            "title": "Prompt",
            "default": "Choose a folder"
          }
        },
        "type": "object",
        "title": "PickIn"
      },
      "RunIn": {
        "properties": {
          "step": {
            "type": "string",
            "enum": [
              "scan",
              "dupes",
              "label",
              "apply"
            ],
            "title": "Step"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "dest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dest"
          },
          "labeler": {
            "type": "string",
            "enum": [
              "claude",
              "jev",
              "stub"
            ],
            "title": "Labeler",
            "default": "claude"
          },
          "limit": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Limit",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "step"
        ],
        "title": "RunIn",
        "description": "One phase on its own. The fields a phase does not need are left out of the request."
      },
      "SortIn": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "dest": {
            "type": "string",
            "title": "Dest"
          },
          "labeler": {
            "type": "string",
            "enum": [
              "claude",
              "jev",
              "stub"
            ],
            "title": "Labeler",
            "default": "claude"
          },
          "limit": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Limit",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "source",
          "dest"
        ],
        "title": "SortIn"
      },
      "StepFlags": {
        "properties": {
          "scan": {
            "type": "boolean",
            "title": "Scan",
            "default": false
          },
          "dupes": {
            "type": "boolean",
            "title": "Dupes",
            "default": false
          },
          "label": {
            "type": "boolean",
            "title": "Label",
            "default": false
          },
          "jev_labels": {
            "type": "boolean",
            "title": "Jev Labels",
            "default": false
          },
          "apply": {
            "type": "boolean",
            "title": "Apply",
            "default": false
          }
        },
        "type": "object",
        "title": "StepFlags"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
