                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit"
          },
          "sorted": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sorted"
          },
          "files": {
            "type": "integer",
            "title": "Files",
            "default": 0
          },
          "bytes": {
            "type": "integer",
            "title": "Bytes",
            "default": 0
          },
          "steps": {
            "$ref": "#/components/schemas/StepFlags"
          },
          "jev_key": {
            "type": "boolean",
            "title": "Jev Key"
          },
          "claude_cli": {
