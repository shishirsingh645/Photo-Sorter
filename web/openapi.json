            "type": "integer",
            "title": "Overrides",
            "default": 0
          },
          "job": {
            "$ref": "#/components/schemas/JobState"
          },
          "platform": {
            "type": "string",
            "title": "Platform"
          },
          "file_manager": {
            "type": "string",
            "title": "File Manager"
          },
          "picker_available": {
            "type": "boolean",
            "title": "Picker Available"
          },
          "picker_reason": {
            "type": "string",
            "title": "Picker Reason",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "categories",
          "steps",
          "jev_key",
          "claude_cli",
          "job",
          "platform",
          "file_manager",
          "picker_available"
        ],
        "title": "AppState"
      },
      "CategoriesIn": {
        "properties": {
          "categories": {
            "items": {
              "$ref": "#/components/schemas/CategoryIn"
            },
            "type": "array",
            "title": "Categories"
          }
        },
        "type": "object",
        "required": [
          "categories"
        ],
        "title": "CategoriesIn"
      },
      "CategoryIn": {
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "title": "Key"
          },
          "kind": {
            "type": "string",
            "enum": [
              "photo",
              "video"
            ],
            "title": "Kind"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "emoji": {
            "type": "string",
            "title": "Emoji"
          },
          "rule": {
            "type": "string",
            "title": "Rule"
          }
        },
        "type": "object",
        "required": [
          "key",
          "kind",
          "label",
          "emoji",
          "rule"
        ],
        "title": "CategoryIn"
      },
      "CategoryOut": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "emoji": {
            "type": "string",
            "title": "Emoji"
          },
          "rule": {
            "type": "string",
            "title": "Rule"
          }
        },
        "type": "object",
        "required": [
          "key",
          "kind",
          "label",
          "emoji",
          "rule"
        ],
        "title": "CategoryOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobState": {
        "properties": {
          "step": {
            "anyOf": [
