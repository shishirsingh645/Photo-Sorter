                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Step"
          },
          "running": {
            "type": "boolean",
            "title": "Running",
            "default": false
          },
          "code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "phase": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phase"
          },
          "phases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Phases"
          },
          "done": {
            "type": "integer",
            "title": "Done",
            "default": 0
          },
          "total": {
            "type": "integer",
            "title": "Total",
            "default": 0
          },
          "started": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started"
          },
          "phase_started": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phase Started"
          },
          "timings": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Timings"
          },
          "log": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Log"
          }
        },
        "type": "object",
        "title": "JobState",
        "description": "The one job the runner may be running. All defaults mean \"idle\"."
